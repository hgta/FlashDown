<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="flashdown.exe"
        Arguments=""
        InstallLocation="C:\Program Files\hgta\FlashDown">
    </Installer>
    <PackageInformation
        PackageName="FlashDown"
        PackageDisplayName="FlashDown"
        PublisherName="CN=hgta"
        PublisherDisplayName="hgta"
        Version="0.1.0.0"
        PackageDescription="FlashGet-inspired download manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.hgta.flashdown"
                Description="FlashGet-inspired download manager"
                DisplayName="FlashDown"
                ExecutableName="flashdown.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>FlashDown</DisplayName>
            <PublisherDisplayName>hgta</PublisherDisplayName>
            <Description>FlashGet-inspired download manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="flashdown.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
